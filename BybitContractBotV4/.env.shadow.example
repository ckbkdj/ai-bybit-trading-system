# Execution service: local Shadow profile. No private exchange API is reachable.
APP_CODE_COMMIT=
BYBIT_TRADING_MODE=shadow
BYBIT_ENABLE_LIVE=false
BYBIT_LIVE_APPROVAL_ID=
BYBIT_DEDICATED_SUBACCOUNT=false
BYBIT_ALLOW_MANUAL_ORDERS=false
BYBIT_POSITION_MODE=one_way
POSITION_OWNER_ID=shadow-primary-owner
APPROVED_STRATEGY_RELEASE_ID=
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

PREDICTION_API_BASE_URL=http://127.0.0.1:8000
PREDICTION_API_ROUTE=/results/{symbol}
PREDICTION_API_TOKEN=
PREDICTION_TLS_VERIFY=true
PREDICTION_CA_BUNDLE=
TICKET_API_BASE_URL=http://127.0.0.1:8000
TICKET_API_TOKEN=
TICKET_CONSUMER_ID=bybit-shadow-primary
EXECUTION_DB_PATH=./execution_state.sqlite3
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787

MAX_RISK_PER_TRADE_PCT=0.0025
MAX_DAILY_LOSS_PCT=0.005
MAX_WEEKLY_LOSS_PCT=0.015
MAX_EQUITY_DRAWDOWN_PCT=0.03
MAX_GROSS_LEVERAGE=2
MAX_MARGIN_UTILIZATION=0.70
REQUIRE_WEBSOCKET_CONFIRMATION=true
