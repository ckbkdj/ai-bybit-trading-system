# Local runtime configuration. Copy to .env.local; never commit .env.local.

# Safe default: records intended orders in memory and never calls private Bybit APIs.
BYBIT_TRADING_MODE=shadow
BYBIT_ENABLE_LIVE=false
# Change-ticket or signed approval identifier; required only for an approved live window.
BYBIT_LIVE_APPROVAL_ID=
BYBIT_POSITION_MODE=hedge
BYBIT_DEDICATED_SUBACCOUNT=false
POSITION_OWNER_ID=shadow-primary-owner
BYBIT_ALLOW_MANUAL_ORDERS=false
# Mandatory allowlist in testnet/live; must equal the ticket release bundle id.
APPROVED_STRATEGY_RELEASE_ID=
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
SHADOW_ACCOUNT_EQUITY_USDT=10000

# Internal prediction service. The legacy /results shape remains supported.
PREDICTION_API_BASE_URL=https://crypto_api.hk.ie520.com
PREDICTION_API_ROUTE=/results/{symbol}
PREDICTION_API_TOKEN=
PREDICTION_TIMEOUT_SECONDS=10
PREDICTION_MAX_AGE_SECONDS=600
PREDICTION_TLS_VERIFY=true
# For an internal CA, prefer a CA bundle path instead of disabling verification.
PREDICTION_CA_BUNDLE=

LARK_WEBHOOK_URL=

# Versioned ticket control plane and durable execution state.
TICKET_API_BASE_URL=https://crypto_api.hk.ie520.com
TICKET_API_TOKEN=
TICKET_CONSUMER_ID=bybit-v4-primary
TICKET_POLL_SECONDS=2
EXECUTION_DB_PATH=./execution_state.sqlite3
# Must match the deployed code revision recorded by DB migrations/release evidence.
APP_CODE_COMMIT=

# Local execution risk limits. Trading code has final veto authority.
MAX_DAILY_LOSS_PCT=0.02
MAX_EQUITY_DRAWDOWN_PCT=0.10
MAX_GROSS_LEVERAGE=2
MAX_CORRELATED_EXPOSURE_PCT=0.35
MAX_MARGIN_UTILIZATION=0.70
MAX_CONSECUTIVE_LOSSES=4
MAX_EXCHANGE_CLOCK_DRIFT_SECONDS=2
REQUIRE_WEBSOCKET_CONFIRMATION=true
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787
