APP_ENV=production
SERVICE_ROLE=predictor
EXECUTION_MODE=paper
BYBIT_TRADING_MODE=shadow
HOST_ID=predictor-paper-01
CLUSTER_ID=two-node-paper
DEPLOYMENT_ID=two-node-paper-v1
APP_CODE_COMMIT=<exact-git-sha>

PREDICTOR_DATA_DIR=/var/lib/ai-bybit/predictor-realtime
FORECAST_PUBLICATION_OUTBOX_DB=/var/lib/ai-bybit/publication-worker/forecast-publication-outbox.sqlite3
CONTROL_PLANE_DB=/var/lib/ai-bybit/control-plane/control-plane.sqlite3
BYBIT_PUBLIC_PIT_STORE=/var/lib/ai-bybit/market-collector/bybit-public.sqlite3
TRAINING_ENABLED=
BACKFILL_ENABLED=

CONTROL_PLANE_BIND_HOST=127.0.0.1
CONTROL_PLANE_BIND_PORT=8000
CONTROL_PLANE_API_TOKEN=<replace-global-control-token>
CONTROL_PLANE_EXECUTOR_TOKENS={"executor-paper-01":"<replace-executor-token>","ops-console":"<replace-ops-token>"}
CONTROL_PLANE_CONSUMER_IDENTITIES={"executor-paper-01":"executor-paper-01","ops-console":"ops-console"}
CONTROL_PLANE_TRUSTED_REVERSE_PROXY=true

OPS_CONSOLE_TOKEN=<replace-browser-console-token-at-least-16-chars>
OPS_CONTROL_PLANE_TOKEN=<replace-ops-token>
OPS_CONTROL_PLANE_CONSUMER_ID=ops-console
OPS_CONTROL_PLANE_CERT_IDENTITY=ops-console
OPS_CONTROL_PLANE_MTLS_CERT=/etc/ai-bybit/pki/ops-console.crt
OPS_CONTROL_PLANE_MTLS_KEY=/etc/ai-bybit/pki/ops-console.key
OPS_CONTROL_PLANE_CA_BUNDLE=/etc/ai-bybit/pki/control-plane-ca.crt
OPS_POLL_SECONDS=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SUPPRESS_SECONDS=300

BYBIT_ENABLE_LIVE=false
MAINNET_ALLOWED=false

# Predictor must never contain BYBIT_API_KEY, BYBIT_SECRET_KEY,
# EXECUTION_DB_PATH, RESEARCH_JOB_DB, TRAINING_ENABLED=true or BACKFILL_ENABLED=true.
