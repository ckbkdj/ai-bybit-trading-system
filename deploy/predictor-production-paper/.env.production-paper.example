APP_ENV=production
SERVICE_ROLE=predictor
EXECUTION_MODE=paper
BYBIT_TRADING_MODE=shadow
HOST_ID=predictor-paper-01
CLUSTER_ID=two-node-paper
DEPLOYMENT_ID=two-node-paper-v1
PREDICTOR_DATA_DIR=/var/lib/ai-bybit/predictor-realtime
FORECAST_PUBLICATION_OUTBOX_DB=/var/lib/ai-bybit/publication-worker/forecast-publication-outbox.sqlite3
CONTROL_PLANE_DB=/var/lib/ai-bybit/control-plane/control-plane.sqlite3
BYBIT_PUBLIC_PIT_STORE=/var/lib/ai-bybit/market-collector/bybit-public.sqlite3
TRAINING_ENABLED=
BACKFILL_ENABLED=
CONTROL_PLANE_BIND_HOST=127.0.0.1
CONTROL_PLANE_API_TOKEN=<inject-global-token-from-secret-store>
CONTROL_PLANE_EXECUTOR_TOKENS={"executor-paper-01":"<inject-unique-executor-token>"}
CONTROL_PLANE_CONSUMER_IDENTITIES={"executor-paper-01":"executor-paper-01"}
CONTROL_PLANE_TRUSTED_REVERSE_PROXY=true
MAINNET_ALLOWED=false

# The production predictor is not a research node and must not define
# RESEARCH_JOB_DB. It must also never define BYBIT_API_KEY, BYBIT_SECRET_KEY,
# or EXECUTION_DB_PATH.
