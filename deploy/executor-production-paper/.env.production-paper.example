APP_ENV=production
SERVICE_ROLE=executor
EXECUTION_MODE=paper
BYBIT_TRADING_MODE=shadow
HOST_ID=executor-paper-01
CLUSTER_ID=two-node-paper
DEPLOYMENT_ID=two-node-paper-v1
EXECUTION_DB_PATH=/var/lib/ai-bybit/executor/execution.sqlite3
TICKET_API_BASE_URL=https://predictor-paper.internal:8443
CONTROL_PLANE_API_TOKEN=<inject-unique-executor-token>
CONTROL_PLANE_MTLS_CERT=/etc/ai-bybit/pki/executor-paper-01.crt
CONTROL_PLANE_MTLS_KEY=/etc/ai-bybit/pki/executor-paper-01.key
CONTROL_PLANE_CERT_IDENTITY=executor-paper-01
PREDICTION_CA_BUNDLE=/etc/ai-bybit/pki/control-plane-ca.crt
TICKET_CONSUMER_ID=executor-paper-01
POSITION_OWNER_ID=paper-owner-executor-01
EXECUTOR_VERSION=1.0.0
MAX_CONTROL_PLANE_CLOCK_DRIFT_SECONDS=5
BYBIT_ENABLE_LIVE=false
MAINNET_ALLOWED=false

# Executor role must never define model, PIT, training, research, or backfill paths.
# Paper mode does not use Bybit private credentials.
