APP_ENV=staging
SERVICE_ROLE=executor
EXECUTION_MODE=testnet
BYBIT_TRADING_MODE=testnet
HOST_ID=executor-testnet-01
CLUSTER_ID=two-node-testnet
DEPLOYMENT_ID=two-node-testnet-v1
EXECUTION_DB_PATH=/var/lib/ai-bybit/executor-testnet/execution.sqlite3
TICKET_API_BASE_URL=https://predictor-testnet.internal:8443
CONTROL_PLANE_API_TOKEN=<inject-unique-testnet-executor-token>
CONTROL_PLANE_MTLS_CERT=/etc/ai-bybit/pki/executor-testnet-01.crt
CONTROL_PLANE_MTLS_KEY=/etc/ai-bybit/pki/executor-testnet-01.key
CONTROL_PLANE_CERT_IDENTITY=executor-testnet-01
PREDICTION_CA_BUNDLE=/etc/ai-bybit/pki/control-plane-ca.crt
TICKET_CONSUMER_ID=executor-testnet-01
POSITION_OWNER_ID=testnet-owner-executor-01
EXECUTOR_VERSION=1.0.0
MAX_CONTROL_PLANE_CLOCK_DRIFT_SECONDS=2
BYBIT_DEDICATED_SUBACCOUNT=true
BYBIT_ALLOW_MANUAL_ORDERS=false
BYBIT_POSITION_MODE=one_way
APPROVED_STRATEGY_RELEASE_ID=<inject-approved-release-id>
APP_CODE_COMMIT=<inject-deployed-commit-sha>
BYBIT_API_KEY=<inject-dedicated-testnet-key>
BYBIT_SECRET_KEY=<inject-dedicated-testnet-secret>
BYBIT_ENABLE_LIVE=false
MAINNET_ALLOWED=false

# Artifact only. This task does not authorize starting testnet.
