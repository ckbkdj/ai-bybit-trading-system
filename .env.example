# Workspace-level values shared by the prediction and execution processes.
# Copy only the relevant entries into each service's .env.local or inject them
# through the process manager. Never place real credentials in this file.

# Exact deployed Git revision. Testnet/live execution rejects an unset value.
APP_CODE_COMMIT=

# Prediction control plane consumed by the execution service.
PREDICTION_API_BASE_URL=http://127.0.0.1:8000
PREDICTION_API_ROUTE=/results/{symbol}
PREDICTION_API_TOKEN=
TICKET_API_BASE_URL=http://127.0.0.1:8000
TICKET_API_TOKEN=

# Shared notifications. Empty disables notifications.
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=

# Safe workspace default. These values must never be promoted implicitly.
BYBIT_TRADING_MODE=shadow
BYBIT_ENABLE_LIVE=false
