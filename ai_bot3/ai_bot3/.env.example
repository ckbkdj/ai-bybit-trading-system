# Inject these values through the process environment on the secure machine.
CONTROL_PLANE_DB=./data/control_plane.sqlite3
RESEARCH_JOB_DB=./data/research_jobs.sqlite3
CONTROL_PLANE_API_TOKEN=
AI_BOT_TICKETS_ENABLED=true
AI_BOT_CORS_ORIGINS=http://127.0.0.1,http://localhost
# Explicitly select the active feature store; switch only after reviewed migration.
AI_BOT_KLINE_FEATURE_STORE_PATH=./data/kline_feature_store.sqlite3
# A verified manifest containing code/model/scaler/calibration/feature/cost hashes.
# Without it forecasts may be recorded, but portfolio tickets are not emitted.
AI_BOT_STRATEGY_RELEASE_BUNDLE=
APP_CODE_COMMIT=

# Profitability runtime artifacts. Empty release/report/manifest values keep the
# new alpha unauthorized and therefore fail closed to NO_TRADE.
AI_BOT_PROFITABILITY_MODEL_BUNDLE=
AI_BOT_PROFITABILITY_REPORT=./model_results/evaluation/profitability_report.json
AI_BOT_CANDIDATE_RELEASE_MANIFEST=./model_results/evaluation/candidate_release_manifest.json
BYBIT_PUBLIC_PIT_STORE=./data/bybit_public_pit.sqlite3
BYBIT_LOCKBOX_PUBLIC_PIT_STORE=
MACRO_PIT_STORE=./data/macro_pit.sqlite3
FLOW_PIT_STORE=./data/flow_pit.sqlite3

# Research/backfill credentials. FRED_API_KEY is a compatibility alias.
TRAD_FRED_API_KEY=
FRED_API_KEY=

# Optional alerting. Leave empty to disable.
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=

# Existing Coinglass collector runtime secrets.
COINGLASS_TOTP_SECRET=
COINGLASS_AES_KEY=

# Optional read-only daily cross-asset context.  Keep unset to disable.
# The adapter never writes to this directory and never feeds live direction
# until PIT/OOS ablation explicitly approves the factor contract.
TRAD_DATA_SERVICE_ROOT=
TRAD_PANEL_VERIFY_SHA256=false

# Optional inference/runtime tuning. Defaults shown here match the code.
AI_BOT_BRAIN_INFERENCE_STAGE=baseline
AI_BOT_REQUIRED_BRAIN_RELEASE_STAGE=live
AI_BOT_FORCE_CPU=0
AI_BOT_ALLOW_PARENT_TF_CLEANUP=0
FEATURE_FETCH_TIMEOUT=45
OHLCV_FETCH_TIMEOUT=60
LIQ_CURRENT_PRICE_MAX_AGE_SECONDS=600
MEMORY_THRESHOLD_PERCENT=88
MAX_MEMORY_PER_TASK_MB=4000
PREDICT_TASK_TIMEOUT=300
TRAIN_TASK_TIMEOUT=7200
PREDICT_MODE_TIMEOUT=1800
TRAIN_MODE_TIMEOUT=21600
WORKER_WATCHDOG_INTERVAL=15
FD_WATERMARK=
FD_HARD_LIMIT=
FD_RESTART_LIMIT=

# Optional OpenAI-compatible context provider. Empty disables the provider.
AI_BOT_LLM_BASE_URL=
AI_BOT_LLM_API_KEY=
AI_BOT_LLM_MODEL=gpt-4o-mini
