{
  "$defs": {
    "ReceiptFill": {
      "additionalProperties": false,
      "properties": {
        "exec_fee": {
          "minimum": 0,
          "title": "Exec Fee",
          "type": "number"
        },
        "exec_id": {
          "title": "Exec Id",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "order_link_id": {
          "title": "Order Link Id",
          "type": "string"
        },
        "price": {
          "exclusiveMinimum": 0,
          "title": "Price",
          "type": "number"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "number"
        }
      },
      "required": [
        "exec_id",
        "order_link_id",
        "quantity",
        "price",
        "exec_fee",
        "executed_at"
      ],
      "title": "ReceiptFill",
      "type": "object"
    },
    "ReceiptOrder": {
      "additionalProperties": false,
      "properties": {
        "avg_exec_price": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avg Exec Price"
        },
        "bybit_order_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bybit Order Id"
        },
        "cum_exec_qty": {
          "minimum": 0,
          "title": "Cum Exec Qty",
          "type": "number"
        },
        "order_link_id": {
          "title": "Order Link Id",
          "type": "string"
        },
        "order_status": {
          "title": "Order Status",
          "type": "string"
        },
        "order_type": {
          "enum": [
            "MARKET",
            "LIMIT"
          ],
          "title": "Order Type",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "quantity": {
          "minimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "order_link_id",
        "order_status",
        "side",
        "order_type",
        "quantity",
        "cum_exec_qty"
      ],
      "title": "ReceiptOrder",
      "type": "object"
    }
  },
  "$id": "execution-receipt.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_equity_usdt": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Equity Usdt"
    },
    "consumer_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Consumer Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "fills": {
      "items": {
        "$ref": "#/$defs/ReceiptFill"
      },
      "title": "Fills",
      "type": "array"
    },
    "mode": {
      "enum": [
        "shadow",
        "testnet",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "orders": {
      "items": {
        "$ref": "#/$defs/ReceiptOrder"
      },
      "title": "Orders",
      "type": "array"
    },
    "position_qty_after": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Position Qty After"
    },
    "position_version_after": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Position Version After"
    },
    "position_version_before": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Position Version Before"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "reason_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Detail"
    },
    "receipt_id": {
      "maxLength": 80,
      "minLength": 8,
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": "execution-receipt.v1",
      "default": "execution-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "RECEIVED",
        "VALIDATED",
        "CLAIMED",
        "RISK_APPROVED",
        "SUBMITTING",
        "SUBMITTED",
        "ACKNOWLEDGED",
        "PARTIALLY_FILLED",
        "FILLED",
        "REJECTED",
        "EXPIRED",
        "CANCELLED",
        "FAILED",
        "SUPERSEDED",
        "RISK_BLOCKED"
      ],
      "title": "Status",
      "type": "string"
    },
    "ticket_id": {
      "maxLength": 80,
      "minLength": 8,
      "title": "Ticket Id",
      "type": "string"
    },
    "total_exec_fee": {
      "default": 0,
      "minimum": 0,
      "title": "Total Exec Fee",
      "type": "number"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "ticket_id",
    "consumer_id",
    "mode",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "ExecutionReceipt",
  "type": "object"
}
